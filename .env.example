# 9527 大模型 RAG 后端配置（OpenAI 兼容）
# 用法：复制本文件为 .env 并填入你的值；.env 已被 .gitignore 忽略，不会进 git。
#
# 默认即「智谱 BigModel GLM-4.7-Flash」：server.py 已内置 LLM_BASE_URL 与
# LLM_MODEL 默认值，因此你通常只需把 LLM_API_KEY 填好即可（本机已配置）。
# 想换其它 OpenAI 兼容模型（DeepSeek / 通义 / OpenAI 等），取消下面注释并改写。

# API 基址（不含末尾的 /chat/completions）。默认值即智谱 BigModel：
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 你的 API Key（智谱 BigModel 形如 id.secret）
LLM_API_KEY=你的智谱APIKey_形如_5d8c7367....QCO4oPW....

# 模型名。默认值即 glm-4.7-flash
LLM_MODEL=glm-4.7-flash

# 可选：大模型调用超时（秒），默认 60
# LLM_TIMEOUT=60
