# 依赖 / 虚拟环境
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# 本地密钥 / 环境
.env
llm_config.json
llm_presets.json
*.local

# 法规库 kb.sqlite 约 238MB，gzip 后约 138MB，超过 GitHub 100MB 单文件限制，
# 故以「分卷 gzip」入库（kb.sqlite.gz.00/.01/...，每卷 40MB），构建时合并解压。
# 索引辅助文件（INDEX.md / metadata.json / 临床前研究板块索引.md）较小，直接入库。
# 排除该目录其余内容（原始 kb.sqlite、sqlite 临时文件 -wal/-shm、可能的符号链接等）。
00_索引/*
!00_索引/kb.sqlite.gz.*
!00_索引/INDEX.md
!00_索引/metadata.json
!00_索引/临床前研究板块索引.md

# 系统文件
.DS_Store
Thumbs.db
backend.log
backend_run.log

# 调试 / 缓存目录
.agents/

# QA工作台（药品研发QA合规管理台）运行时数据库与日志（本地同步，不入库）
api/qa_workbench.db
api/qa_workbench.db-wal
api/qa_workbench.db-shm
wb_server.log
